# Copie este archivo como .env y ajuste los valores.
DEBUG=1
DJANGO_SECRET_KEY=cambie-esta-clave
ALLOWED_HOSTS=127.0.0.1,localhost
PUBLIC_BASE_URL=http://127.0.0.1:8000

# PostgreSQL (si DB_NAME está vacío se usa SQLite)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Correo (si no hay usuario/clave, los correos salen por consola)
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Verificación en línea con fondos (modo API)
FONDOS_API_TIMEOUT=8
# Token de cada fondo: el nombre de la variable se configura en el admin (api_token_env)
# FONDO_EJEMPLO_TOKEN=
